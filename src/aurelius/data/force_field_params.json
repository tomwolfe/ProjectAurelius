      "(8, 8)": {"epsilon": 0.01200, "sigma": 3.1200, "atom": "O-O", "source": "OPLS-AA"},
      "(8, 9)": {"epsilon": 0.01200, "sigma": 2.950, "atom": "O-F", "source": "OPLS-AA"},
      "(8, 11)": {"epsilon": 0.03000, "sigma": 2.800, "atom": "O-Na", "source": "GAFF"},
      "(8, 3)": {"epsilon": 0.02500, "sigma": 2.600, "atom": "O-Li", "source": "GAFF"},
      "(8, 15)": {"epsilon": 0.02000, "sigma": 2.850, "atom": "O-P", "source": "GAFF"},
      "(8, 16)": {"epsilon": 0.01200, "sigma": 3.050, "atom": "O-S", "source": "OPLS-AA"},
      "(9, 9)": {"epsilon": 0.01200, "sigma": 2.850, "atom": "F-F", "source": "OPLS-AA"},
      "(9, 11)": {"epsilon": 0.01500, "sigma": 2.700, "atom": "F-Na", "source": "GAFF"},
      "(9, 3)": {"epsilon": 0.02000, "sigma": 2.550, "atom": "F-Li", "source": "GAFF"},
      "(9, 15)": {"epsilon": 0.01500, "sigma": 2.800, "atom": "F-P", "source": "GAFF"},
      "(11, 11)": {"epsilon": 0.00800, "sigma": 2.500, "atom": "Na-Na", "source": "GAFF"},
      "(11, 15)": {"epsilon": 0.01200, "sigma": 2.750, "atom": "Na-P", "source": "GAFF"},
      "(11, 19)": {"epsilon": 0.00600, "sigma": 2.400, "atom": "Na-K", "source": "GAFF"},
      "(3, 3)": {"epsilon": 0.01500, "sigma": 2.650, "atom": "Li-Li", "source": "GAFF"},
      "(3, 15)": {"epsilon": 0.01800, "sigma": 2.700, "atom": "Li-P", "source": "GAFF"},
      "(3, 19)": {"epsilon": 0.00800, "sigma": 2.500, "atom": "Li-K", "source": "GAFF"},
      "(15, 15)": {"epsilon": 0.01000, "sigma": 2.900, "atom": "P-P", "source": "GAFF"},
      "(15, 16)": {"epsilon": 0.01200, "sigma": 3.050, "atom": "P-S", "source": "GAFF"},
      "(16, 16)": {"epsilon": 0.01500, "sigma": 3.200, "atom": "S-S", "source": "OPLS-AA"},
      "(19, 19)": {"epsilon": 0.00500, "sigma": 2.350, "atom": "K-K", "source": "GAFF"},
      "(19, 15)": {"epsilon": 0.01000, "sigma": 2.700, "atom": "K-P", "source": "GAFF"}
    }
  },

  "partial_charges": {
    "notes": "Partial charges for common atoms in battery electrolyte environments. Derived from ESP fitting (OPLS-AA) or Mulliken analysis (GAFF). Includes fluorine and phosphorus for PF6- salt modeling.",
    "default_charge": 0.0,
    "parameters": {
      "1": {"charge": 0.0, "atom": "H", "source": "OPLS-AA"},
      "6": {"charge": 0.0, "atom": "C", "source": "OPLS-AA"},
      "7": {"charge": 0.0, "atom": "N", "source": "OPLS-AA"},
      "8": {"charge": -0.417, "atom": "O", "source": "OPLS-AA"},
      "9": {"charge": -0.150, "atom": "F", "source": "OPLS-AA"},
      "11": {"charge": 0.889, "atom": "Na+", "source": "GAFF"},
      "3": {"charge": 0.650, "atom": "Li+", "source": "GAFF"},
      "19": {"charge": 0.950, "atom": "K+", "source": "GAFF"},
      "15": {"charge": 1.200, "atom": "P(in PF6-)", "source": "GAFF"},
      "16": {"charge": -0.050, "atom": "S", "source": "OPLS-AA"}
    }
  },

  "atomic_radii": {
    "notes": "Bondi van der Waals radii used for GB radius calculation (Angstroms). Expanded with F, P, S for battery salt modeling.",
    "parameters": {
